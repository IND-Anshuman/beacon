{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/nest-dist.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "build": {
    "env": {
      "SITE_URL": "https://www.anshumanbuilds.dev",
      "BASE_PATH": "/beacon"
    }
  },
  "headers": [
    {
      "source": "/beacon/_astro/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/beacon/beacon.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ]
}
