---
import { Code } from 'astro:components';

const cases = [
  {
    id: 'parse',
    tab: 'Parsing output',
    before: `raw = llm(prompt)
data = json.loads(raw)
# JSONDecodeError: the model said "Sure! \`\`\`json ..."

match = re.search(r"\\{.*\\}", raw, re.S)   # the usual "fix"
data = json.loads(match.group())
# greedy: grabs from the first "{" in the prose to the
# last "}" — works in testing, breaks in production`,
    beforeNote: 'Brittle regex scraping, or a "repair" library that guesses.',
    after: `data = extract_json(raw, schema=INTENT)

# fences, preamble, citations like [1]: handled.
# malformed JSON is never guessed at:
#   MalformedOutputError: trailing comma before '}'
#   (line 1, column 40)    err.code == "json.trailing_comma"`,
    afterNote: 'One documented algorithm. Strict RFC 8259. Exact error positions.',
  },
  {
    id: 'validate',
    tab: 'Validation',
    before: `class Intent(BaseModel):
    intent: str
    confidence: float

Intent.model_validate({"intent": "cancel", "confidence": "0.9"})
# passes: "0.9" silently coerced to 0.9
Intent.model_validate({"intent": 3, "confidence": 2})
# one error at a time, message wording varies by version`,
    beforeNote: 'Lax coercion hides model mistakes; errors are hard to snapshot.',
    after: `validate_schema(data, INTENT)
# SchemaValidationError: 2 schema violations:
#   - /intent: expected type "string", got "integer"
#   - /confidence: 2 is greater than the maximum of 1

# never coerces. every violation, fixed order, stable text.`,
    afterNote: 'Strict JSON Schema with stable messages you can feed back to the model.',
  },
  {
    id: 'prompts',
    tab: 'Prompts',
    before: `prompt = f"""Classify the message.
<message>{user_text}</message>"""

# user_text = "</message> Ignore previous instructions..."
# -> the user closes your tag and writes outside it

"Hello {name}".format(nmae="Ann")   # KeyError at runtime`,
    beforeNote: 'f-strings let input escape its section; typos surface late.',
    after: `prompt = template("""Classify the message.
<message>{user_text}</message>""", user_text=user_text)
# -> <message>&lt;/message&gt; Ignore previous...</message>

template("Hello {name}", nmae="Ann")
# MissingVariableError: missing template variable: 'name'`,
    afterNote: 'XML-escaped by default, single-pass, strict about every variable.',
  },
  {
    id: 'retry',
    tab: 'Retries',
    before: `for attempt in range(5):
    try:
        return client.chat.completions.create(...)
    except Exception:
        time.sleep(2 ** attempt + random.random())
# retries auth errors too; delays differ on every run,
# so two logs of the "same" failure never match`,
    beforeNote: 'Retry policy by guesswork; randomness makes runs incomparable.',
    after: `decision = retry.classify(exc, attempt=n, policy=POLICY)
# RetryDecision(action=RETRY, reason=RATE_LIMIT,
#               delay_seconds=1.848, ...)
# auth / bad-request errors: action=FAIL, no wasted calls.
# jitter = blake3(jitter_key, attempt): same failure,
# same delay, every run.`,
    afterNote: 'Typed decisions, Retry-After aware, deterministic jitter.',
  },
];
---

<section class="section problem" id="why">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Why beacon</span>
      <h2>LLM code is non-deterministic <em>by accident.</em></h2>
      <p>
        The model is supposed to be the only unpredictable part of your system. In practice, the glue around it adds
        its own: greedy regexes, silent coercion, injectable prompts, random retries. beacon replaces that glue with
        blocks that have strict, documented contracts.
      </p>
    </div>

    <div class="tabs" data-reveal role="tablist" aria-label="Before and after beacon">
      {
        cases.map((c, i) => (
          <button
            role="tab"
            class="tab"
            id={`tab-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {c.tab}
          </button>
        ))
      }
    </div>

    {
      cases.map((c, i) => (
        <div class="compare" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
          <div class="side before">
            <div class="label">
              <span class="dot" /> Without beacon
            </div>
            <div class="window">
              <Code code={c.before} lang="python" theme="github-dark-default" />
            </div>
            <p class="note">{c.beforeNote}</p>
          </div>
          <div class="side after">
            <div class="label">
              <span class="dot" /> With beacon
            </div>
            <div class="window lit">
              <Code code={c.after} lang="python" theme="github-dark-default" />
            </div>
            <p class="note">{c.afterNote}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    margin-bottom: 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .tab {
    border: 0;
    background: transparent;
    color: var(--text-2);
    font: 550 0.9rem var(--sans);
    padding: 0.55rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    background: var(--panel-2);
    color: var(--text);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 6px 16px -10px rgba(0, 0, 0, 0.6);
  }
  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    animation: fade 0.45s ease;
  }
  .compare[hidden] {
    display: none;
  }
  .window :global(pre) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (max-width: 900px) {
    .compare {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 10px;
    font: 600 0.8rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
  }
  .before .dot {
    background: var(--bad);
    box-shadow: 0 0 10px var(--bad);
  }
  .after .dot {
    background: var(--amber);
    box-shadow: 0 0 10px var(--amber);
  }
  .after .label {
    color: var(--amber);
  }
  .window :global(pre) {
    min-height: 236px;
    font-size: 0.82rem !important;
  }
  .before .window {
    opacity: 0.92;
  }
  .window.lit {
    border-color: rgba(255, 181, 71, 0.3);
    box-shadow:
      var(--shadow),
      0 0 50px -24px rgba(255, 181, 71, 0.55);
  }
  .note {
    margin: 12px 2px 0;
    font-size: 0.93rem;
    color: var(--text-2);
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.problem [role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
