---
import { Code } from 'astro:components';
import { url } from '../../site';

const steps = [
  {
    title: 'Install',
    body: 'One abi3 wheel per platform covers Python 3.10 to 3.14. No Rust toolchain needed.',
    lang: 'bash',
    code: `pip install llm-beacon
# optional integrations
pip install "llm-beacon[langchain]"`,
  },
  {
    title: 'Wrap your model call',
    body: 'Render the prompt, call any LLM client, then extract and validate the result.',
    lang: 'python',
    code: `from beacon import template, extract_json

prompt = template("Classify: <m>{m}</m>", m=message)
raw = llm(prompt)                # any client
intent = extract_json(raw, schema=INTENT)`,
  },
  {
    title: 'Lock it in with a snapshot',
    body: 'Record a real response once. From then on, any behaviour change shows up as a diff.',
    lang: 'python',
    code: `from beacon.snapshots import assert_snapshot

def test_cancel():
    assert_snapshot("intents/cancel",
                    extract_json(RECORDED, schema=INTENT))`,
  },
];
---

<section class="section setup" id="setup">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Get started</span>
      <h2>From install to a tested pipeline <em>in five minutes.</em></h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 90}ms`}>
            <div class="num">{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div class="window">
              <button class="copy" type="button" data-copy={s.code} aria-label={`Copy step ${i + 1} code`}>
                <span class="copy-label">Copy</span>
              </button>
              <Code code={s.code} lang={s.lang as 'bash' | 'python'} theme="github-dark-default" />
            </div>
          </li>
        ))
      }
    </ol>
    <div class="actions" data-reveal>
      <a class="btn btn-primary" href={url('/getting-started/quickstart/')}>Read the quickstart</a>
      <a class="btn btn-ghost" href={url('/getting-started/core-concepts/')}>Core concepts</a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
  }
  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .num {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    font: 600 0.9rem var(--mono);
    color: var(--amber);
    border: 1px solid color-mix(in srgb, var(--amber) 45%, transparent);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    box-shadow: 0 0 24px -6px var(--amber-glow);
  }
  h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    font-weight: 620;
  }
  p {
    margin: 0 0 1rem;
    color: var(--text-2);
    font-size: 0.95rem;
    flex: 1;
  }
  .window :global(pre) {
    min-height: 138px;
    font-size: 0.8rem !important;
  }
  .copy {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: #aeb5c2;
    font: 500 0.72rem var(--sans);
    padding: 0.25rem 0.6rem;
    border-radius: 7px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .window:hover .copy,
  .copy:focus-visible,
  .copy[data-copied] {
    opacity: 1;
  }
  .copy[data-copied] {
    color: #5ee0a8;
  }
  @media (hover: none) {
    .copy {
      opacity: 1;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 36px;
  }
</style>
