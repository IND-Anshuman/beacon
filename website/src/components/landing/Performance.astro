---
// Median per-call times from benches/determinism_overhead.py (release build,
// Python 3.14, typical LLM-sized inputs).
const rows = [
  { name: 'template', us: 1.2 },
  { name: 'parse_tool_call', us: 1.2 },
  { name: 'retry.classify', us: 2.0 },
  { name: 'hash_content', us: 2.2 },
  { name: 'extract_json', us: 2.5 },
  { name: 'normalize', us: 5.8 },
  { name: 'validate_schema', us: 9.3 },
  { name: 'redact', us: 10.2 },
];
const scale = 12;
---

<section class="section perf">
  <div class="container grid">
    <div data-reveal>
      <span class="eyebrow">Performance</span>
      <h2>Microseconds, <em>not milliseconds.</em></h2>
      <p>
        The blocks are compiled Rust, so they barely touch your latency budget. The project's target is under 0.5 ms
        per call, and every block comes in around <strong>50× under it</strong>. Determinism doesn't have to cost
        anything.
      </p>
      <div class="big">
        <span class="num">50×</span>
        <span class="cap">headroom under the<br />0.5 ms per-call budget</span>
      </div>
    </div>

    <div class="chart card" data-reveal style="--d: 120ms" role="img" aria-label="Median microseconds per call for each block">
      <div class="chart-head">
        <span>median per call</span>
        <span class="unit">µs</span>
      </div>
      {
        rows.map((r, i) => (
          <div class="row" style={`--w:${(r.us / scale) * 100}%; --i:${i}`}>
            <code>{r.name}</code>
            <div class="track">
              <div class="fill" />
            </div>
            <span class="val">{r.us.toFixed(1)}</span>
          </div>
        ))
      }
      <div class="budget">
        <span class="line"></span>
        Budget: 500 µs per call (≈ 40× the width of this chart)
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  h2 {
    margin: 0.9rem 0;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 640;
  }
  h2 em {
    font-family: var(--serif);
    font-weight: 400;
  }
  p {
    color: var(--text-2);
    font-size: 1.08rem;
  }
  p strong {
    color: var(--text);
  }
  .big {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .num {
    font: 600 clamp(3rem, 6vw, 4.4rem) / 1 var(--sans);
    letter-spacing: -0.05em;
    background: linear-gradient(120deg, #ffe0a8, var(--amber), #ff8a1a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global([data-theme='light']) .num {
    background: linear-gradient(120deg, #d97706, #9a3412);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .cap {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .chart {
    padding: 22px 22px 18px;
  }
  .chart-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font: 500 0.7rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .unit {
    text-transform: none;
  }
  .row {
    display: grid;
    grid-template-columns: 9.5rem 1fr 2.6rem;
    align-items: center;
    gap: 12px;
    padding: 7px 0;
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 7.6rem 1fr 2.4rem;
    }
    .row code {
      font-size: 0.72rem !important;
    }
  }
  .row code {
    font: 0.8rem var(--mono);
    color: var(--text-2);
  }
  .track {
    height: 10px;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
  }
  .fill {
    height: 100%;
    width: 0;
    border-radius: 99px;
    background: linear-gradient(90deg, #ffc56b, #ff9a1f);
    box-shadow: 0 0 16px -2px rgba(255, 166, 40, 0.6);
    transition: width 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(200ms + var(--i) * 70ms);
  }
  :global(.in) .fill {
    width: var(--w);
  }
  .val {
    font: 600 0.84rem var(--mono);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .budget {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .line {
    width: 22px;
    border-top: 2px dashed var(--bad);
  }
</style>
