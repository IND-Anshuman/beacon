---
import logo from '../../assets/logo.svg?raw';
import { SITE, url } from '../../site';

const links = [
  { href: url('/getting-started/introduction/'), label: 'Docs' },
  { href: url('/blocks/extract-json/'), label: 'Blocks' },
  { href: url('/snapshots/overview/'), label: 'Snapshots' },
  { href: url('/integrations/overview/'), label: 'Integrations' },
  { href: url('/playground/'), label: 'Playground' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={url('/')} aria-label="beacon home">
      <span class="mark" set:html={logo} />
      <span>beacon</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      {
        SITE.repoUrl && (
          <a class="icon-btn" href={SITE.repoUrl} aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
            </svg>
          </a>
        )
      }
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
      </button>
      <a class="btn btn-primary small" href={url('/getting-started/quickstart/')}>Get started</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
  }
  :global(body[data-scrolled]) .nav {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 680;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .mark :global(svg) {
    width: 26px;
    height: 26px;
    filter: drop-shadow(0 0 10px rgba(255, 181, 71, 0.45));
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  nav a:hover {
    color: var(--text);
    background: var(--line);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--line-2);
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  .small {
    height: 38px;
    padding-inline: 1rem;
    font-size: 0.88rem;
  }
  @media (max-width: 900px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .small {
      display: none;
    }
  }
</style>

<script>
  const onScroll = () => document.body.toggleAttribute('data-scrolled', window.scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
